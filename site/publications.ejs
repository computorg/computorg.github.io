```{=html}
<div class="computo-publications">
<%
// Group items by year
let currentYear = null;
for (const item of items) {
  let gh = "https://github.com/computorg/" + item.repo;
  let pageurl = item.url ? item.url : "https://doi.org/" + item.doi;
  // Mock contributions carry a placeholder DOI (10.57750/xxx-xxx): no DOI, no reviews, no archive
  let hasdoi = item.doi && !item.doi.includes("xxx");
  let pdfurl = item.pdf ? item.pdf : (item.url ? item.url.replace(/\/?$/, "/") + "main.pdf" : "");
  if (item.year !== currentYear) {
    if (currentYear !== null) { %>
</div> <!-- End previous year section -->
    <% } %>
    <h2 class="mt-5 mb-3 text-primary"><%= item.year %></h2>
    <div class="year-section">
    <% currentYear = item.year;
  } %>
      <div class="publication mb-4" id="<%= item.repo %>">
        <h5 class="mb-1"><a href="<%= pageurl %>"><%= item.title %></a></h5>
        <% if (item.authors) { %>
        <p class="text-muted mb-1"><%= item.authors %></p>
        <% } %>
        <p class="text-muted mb-2"><em>Computo</em>, <%= item.year %>.<% if (hasdoi) { %> <a href="https://doi.org/<%= item.doi %>">https://doi.org/<%= item.doi %></a><% } %></p>
        <div class="publication-links" role="group" aria-label="Article links">
          <a class="btn btn-outline-secondary btn-sm" href="<%= pageurl %>"><i class="bi bi-filetype-html"></i> HTML</a>
          <% if (pdfurl) { %>
          <a class="btn btn-outline-secondary btn-sm" href="<%= pdfurl %>"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
          <% } %>
          <a class="btn btn-outline-secondary btn-sm" href="<%= gh %>"><i class="bi bi-github"></i> Code</a>
          <% if (hasdoi) { %>
          <a class="btn btn-outline-secondary btn-sm" href="<%= gh %>/issues?q=is%3Aissue+label%3Areview"><i class="bi bi-chat-left-text"></i> Reviews</a>
          <a class="btn btn-outline-secondary btn-sm" href="https://archive.softwareheritage.org/browse/origin/?origin_url=<%= gh %>"><i class="bi bi-archive"></i> Archive</a>
          <% } %>
          <% if (item.bibtex) { %>
          <button type="button" class="btn btn-outline-secondary btn-sm bibtex-copy" data-bibtex="<%= item.bibtex %>" title="Copy the BibTeX entry"><i class="bi bi-quote"></i> BibTeX</button>
          <% } %>
          <a class="build-status" href="<%= gh %>/actions/workflows/build.yml" title="Does the article still rebuild from its code? Last run of the build workflow">
            <img src="https://img.shields.io/github/actions/workflow/status/computorg/<%= item.repo %>/build.yml?label=build&logo=github" alt="Build status of <%= item.repo %>" height="20" loading="lazy" />
          </a>
        </div>
      </div>
<% } %>
<% if (currentYear !== null) { %>
</div> <!-- End last year section -->
<% } %>
</div>

<style>
  .computo-publications h5 { font-size: 1.1em; }
  .computo-publications p { text-align: left; }
  .computo-publications .text-muted { font-size: 0.95em; }
  .publication-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .publication-links .btn { padding: 0.15em 0.6em; font-size: 0.85em; }
  .publication-links .build-status { line-height: 0; margin-left: 0.25rem; }
  .publication { scroll-margin-top: 5rem; }
</style>

<script>
  document.addEventListener("click", function (event) {
    var button = event.target.closest(".bibtex-copy");
    if (!button) return;
    navigator.clipboard.writeText(button.dataset.bibtex).then(function () {
      var label = button.innerHTML;
      button.innerHTML = '<i class="bi bi-check2"></i> Copied';
      setTimeout(function () { button.innerHTML = label; }, 1500);
    });
  });
</script>
```
